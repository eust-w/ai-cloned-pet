# Let build/test tools set NODE_ENV; do not force development for production builds.
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=.data/ai-cloned-pet.sqlite
STORAGE_ROOT=.data/storage
MAX_UPLOAD_MB=200

# Required for real vision identity, cartoon avatar generation, and LLM action planning.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=
OPENAI_IMAGE_MODEL=
DASHSCOPE_IMAGE_ENDPOINT=
